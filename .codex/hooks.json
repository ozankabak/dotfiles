{
  "description": "Block shell commands that reference paths outside the workspace, /tmp, or Codex state.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3.14 \"${CODEX_HOME:-$HOME/.codex}/hooks/path_check.py\"",
            "statusMessage": "Checking command paths"
          }
        ]
      }
    ]
  }
}
